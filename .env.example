# 服务端
PORT=3000
HOST=0.0.0.0
JWT_SECRET=请改成随机长字符串
CORS_ORIGIN=https://你的域名
LOG_LEVEL=info
# 用户与战绩的持久化目录（JSON Lines）；留空则只存内存，重启即丢
DATA_DIR=./data

# LiveKit（留空则语音功能禁用，游戏可正常进行）
LIVEKIT_URL=wss://你的域名/rtc
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# 部署（docker compose 使用）
DOMAIN=你的域名
LIVEKIT_KEYS="APIxxxxxxx: 对应的secret"
MYSQL_ROOT_PASSWORD=请改成强密码
